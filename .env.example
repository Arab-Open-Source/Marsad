# Copy to .env and fill in real values before running docker compose.
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Generate with: openssl rand -base64 32  (must decode to exactly 32 bytes)
MARSAD_VAULT_KEY=replace-with-base64-of-32-random-bytes

# Public hostname used for URL generation
PHX_HOST=localhost

# Host port mapped to the container
PORT=4000
