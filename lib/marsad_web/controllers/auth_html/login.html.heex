<Layouts.app flash={@flash}>
  <div class="mx-auto w-full max-w-md py-10">
    <div class="mb-6 flex items-center gap-3">
      <img src={~p"/images/logo.png"} alt="Marsad" class="h-11 w-11 object-contain" />
      <div>
        <p class="text-lg font-bold tracking-tight">Marsad OS</p>
        <p class="text-xs text-base-content/60">Sign in to continue</p>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-content/10 shadow-xl">
      <div class="card-body">
        <h1 id="auth-title" class="card-title">Sign in</h1>
        <.form for={@form} id="login-form" action={~p"/login"} method="post">
          <.input
            field={@form[:username]}
            type="text"
            label="Username"
            autocomplete="username"
            required
          />
          <.input
            field={@form[:password]}
            type="password"
            label="Password"
            autocomplete="current-password"
            required
          />
          <p :if={@error} id="login-error" role="alert" class="text-sm text-error">{@error}</p>
          <button type="submit" id="login-submit" class="btn btn-primary w-full mt-2">
            Sign in
          </button>
        </.form>
        <p class="mt-3 text-sm text-base-content/60">
          First time here?
          <.link href={~p"/setup"} class="link link-primary">
            Create the admin account
          </.link>
        </p>
      </div>
    </div>

    <p class="mt-4 text-center text-xs text-base-content/50">
      <.link navigate={~p"/offline"} class="link">Connection troubles? Open the offline page</.link>
    </p>
  </div>
</Layouts.app>
