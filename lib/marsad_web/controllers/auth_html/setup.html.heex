<Layouts.app flash={@flash}>
  <div class="mx-auto w-full max-w-md py-10">
    <div class="mb-6 flex items-center gap-3">
      <img src={~p"/images/logo.png"} alt="Marsad" class="h-11 w-11 object-contain" />
      <div>
        <p class="text-lg font-bold tracking-tight">Marsad OS</p>
        <p class="text-xs text-base-content/60">First-time setup — create the admin account</p>
      </div>
    </div>

    <div class="card bg-base-100 border border-base-content/10 shadow-xl">
      <div class="card-body">
        <h1 id="auth-title" class="card-title">Create admin account</h1>
        <p class="text-sm text-base-content/60">
          This account lives only on this server. You can change its password later from Settings.
        </p>
        <.form for={@form} id="setup-form" action={~p"/setup"} method="post">
          <.input
            field={@form[:username]}
            type="text"
            label="Username"
            autocomplete="username"
            required
          />
          <.input
            field={@form[:password]}
            type="password"
            label="Password (min 8 characters)"
            autocomplete="new-password"
            required
          />
          <button type="submit" id="setup-submit" class="btn btn-primary w-full mt-2">
            Create account & sign in
          </button>
        </.form>
        <p class="mt-3 text-sm text-base-content/60">
          Already set up? <.link href={~p"/login"} class="link link-primary">Sign in</.link>
        </p>
      </div>
    </div>
  </div>
</Layouts.app>
