<Layouts.flash_group flash={@flash} />

<!-- Product Hero -->
<section class="relative overflow-hidden">
  <div class="absolute inset-0 bg-slate-950"></div>
  <div
    class="absolute inset-0 opacity-[0.015]"
    style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 100 100%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cdefs%3E%3Cpattern id=%22grid%22 width=%22100%22 height=%22100%22 patternUnits=%22userSpaceOnUse%22%3E%3Cpath d=%22M 100 0 L 0 0 0 100%22 fill=%22none%22 stroke=%22white%22 stroke-width=%220.3%22/%3E%3C/pattern%3E%3C/defs%3E%3Crect width=%22100%22 height=%22100%22 fill=%22url(%23grid)%22/%3E%3C/svg%3E');"
  >
  </div>

  <div class="relative max-w-6xl mx-auto px-6 pt-16 pb-24 lg:pt-24 lg:pb-32">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16">
      <!-- Left: Product Info -->
      <div class="lg:col-span-5 flex flex-col justify-center">
        <div class="flex items-center gap-4 mb-8">
          <img src={~p"/images/logo.svg"} alt="Marsad" class="h-10 w-10" />
          <div>
            <span class="text-lg font-semibold tracking-tight text-slate-100">Marsad</span>
            <span class="ml-2 text-xs font-mono text-slate-500">v{Application.spec(:phoenix, :vsn)}</span>
          </div>
        </div>

        <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white leading-[1.15] mb-6">
          Infrastructure monitoring for Elixir deployments
        </h1>
        <p class="text-base text-slate-400 leading-relaxed mb-8 max-w-md">
          Fleet observability with SSH access, metrics collection, and real-time telemetry.
          One dashboard for every node you run.
        </p>

        <div class="flex flex-wrap gap-3">
          <a
            href="/dashboard"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 text-sm font-semibold rounded-lg transition-colors duration-150"
          >
            Open LiveDashboard
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
            ><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
          </a>
          <a
            href="https://hexdocs.pm/phoenix"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-sm font-medium rounded-lg border border-slate-700 transition-colors duration-150"
          >
            Documentation
          </a>
        </div>
      </div>

      <!-- Right: Live Dashboard Preview -->
      <div class="lg:col-span-7">
        <div class="bg-slate-900 border border-slate-800 rounded-xl shadow-2xl shadow-black/50 overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 bg-slate-900 border-b border-slate-800">
            <div class="w-2.5 h-2.5 rounded-full bg-emerald-500 status-live"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-slate-700"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-slate-700"></div>
            <span class="ml-3 text-xs font-mono text-slate-500">marsad — live metrics</span>
          </div>
          <div class="p-5 font-mono text-[13px] leading-[1.7]">
            <div class="flex items-center justify-between mb-4">
              <span class="text-slate-400">Telemetry</span>
              <span class="text-xs text-slate-600">refreshes every 1s</span>
            </div>
            <div class="grid grid-cols-3 gap-4 mb-4">
              <div class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                <div class="text-[10px] text-slate-500 mb-1">Sessions</div>
                <div class="text-xl font-semibold text-emerald-400">247</div>
                <div class="h-1 bg-slate-700 rounded mt-2">
                  <div class="h-full w-[65%] bg-emerald-500 rounded"></div>
                </div>
              </div>
              <div class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                <div class="text-[10px] text-slate-500 mb-1">Throughput</div>
                <div class="text-xl font-semibold text-sky-400">1.2k/s</div>
                <div class="h-1 bg-slate-700 rounded mt-2">
                  <div class="h-full w-[42%] bg-sky-500 rounded"></div>
                </div>
              </div>
              <div class="p-3 bg-slate-800/50 rounded-lg border border-slate-700/50">
                <div class="text-[10px] text-slate-500 mb-1">Latency</div>
                <div class="text-xl font-semibold text-amber-400">4ms</div>
                <div class="h-1 bg-slate-700 rounded mt-2">
                  <div class="h-full w-[8%] bg-amber-500 rounded"></div>
                </div>
              </div>
            </div>
            <div class="text-slate-600 text-xs">Real-time telemetry from MarsadWeb.Telemetry</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities -->
<section class="bg-slate-900 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <div class="mb-12">
      <h2 class="text-2xl font-semibold text-white mb-2">Observe everything</h2>
      <p class="text-slate-400">One interface across your entire infrastructure.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-slate-800 border border-slate-800 rounded-lg overflow-hidden">
      <div class="bg-slate-900 p-8">
        <div class="w-9 h-9 rounded-lg bg-amber-500/10 border border-amber-500/20 flex items-center justify-center mb-5">
          <svg
            class="w-4 h-4 text-amber-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
          /></svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Live Telemetry</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          VM metrics, request counts, and LiveView mount times — collected out of the box via MarsadWeb.Telemetry.
        </p>
      </div>

      <div class="bg-slate-900 p-8">
        <div class="w-9 h-9 rounded-lg bg-sky-500/10 border border-sky-500/20 flex items-center justify-center mb-5">
          <svg
            class="w-4 h-4 text-sky-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          /></svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Terminal Access</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          Open an xterm.js terminal connected to any node. Ephemeral SSH tunnels that auto-expire for security.
        </p>
      </div>

      <div class="bg-slate-900 p-8">
        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center mb-5">
          <svg
            class="w-4 h-4 text-emerald-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
          /></svg>
        </div>
        <h3 class="text-base font-semibold text-white mb-2">Fleet Overview</h3>
        <p class="text-sm text-slate-400 leading-relaxed">
          See all your deployments at a glance with per-node status, metrics, and a unified SSH bastion.
        </p>
      </div>
    </div>

    <div class="mt-12 border-t border-slate-800 pt-8">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-sm">
        <div>
          <div class="text-slate-600 mb-1">Protocol</div><div class="text-slate-300">
            Phoenix LiveView
          </div>
        </div>
        <div>
          <div class="text-slate-600 mb-1">Transport</div><div class="text-slate-300">
            WebSocket
          </div>
        </div>
        <div>
          <div class="text-slate-600 mb-1">Max nodes</div><div class="text-slate-300">
            Unlimited
          </div>
        </div>
        <div>
          <div class="text-slate-600 mb-1">License</div><div class="text-slate-300">MIT</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-slate-950 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-slate-500">
      <div class="flex items-center gap-3">
        <img src={~p"/images/logo.svg"} alt="Marsad" class="h-5 w-5" />
        <span>Marsad — Infrastructure monitoring for Elixir</span>
      </div>
      <div class="flex items-center gap-5">
        <a
          href="https://github.com/phoenixframework/phoenix"
          class="hover:text-slate-300 transition-colors"
        >GitHub</a>
        <a href="https://elixir-lang.org" class="hover:text-slate-300 transition-colors">Elixir</a>
        <a href="https://hexdocs.pm/phoenix" class="hover:text-slate-300 transition-colors">Docs</a>
      </div>
    </div>
  </div>
</footer>
